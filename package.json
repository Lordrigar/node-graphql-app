{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "app/index.js",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^11.0.6",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.31.0",
    "mongoose": "^9.11.4",
    "nodemon": "^2.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "shortid": "^2.2.16",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10"
  },
  "jest": {
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "<rootDir>/app/tests/setup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "collectCoverageFrom": [
        "!**/coverage/**",
        "!**/tests/**",
        "!**/schema/**",
        "!**/models/**"
      ]
    }
  },
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js, json}": [
      "prettier --write",
      "git add"
    ]
  },
  "scripts": {
    "start": "node app/index.js",
    "dev": "nodemon app/index.js",
    "debug": "node debug app/index.js",
    "prepare:test-db": "node app/tests/prepare-memory-server.js",
    "test": "./node_modules/.bin/jest --runInBand --detectOpenHandles --testEnvironment node .",
    "lint": "./node_modules/.bin/eslint .",
    "make-pretty": "./node_modules/.bin/prettier --write \"**/*.{js, json}\""
  },
  "author": "Lordrigar <https://www.github.com/Lordrigar>",
  "license": "ISC"
}
